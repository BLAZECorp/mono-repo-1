{
  "name": "backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "prisma:generate": "node --env-file=.env ./node_modules/prisma/build/index.js generate",
    "db:push": "node --env-file=.env ./node_modules/prisma/build/index.js db push",
    "db:migrate": "node --env-file=.env ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file=.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "db:studio": "node --env-file=.env ./node_modules/prisma/build/index.js studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}