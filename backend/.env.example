NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hono_db?schema=public

# Redis Configuration (Caching, Session Blacklist, Rate Limiting)
REDIS_URL=redis://localhost:6379

# Authentication & Security (Jose JWT)
JWT_SECRET=super-secret-jwt-key-at-least-32-characters-long-enterprise
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
