{
  "name": "hr-management",
  "private": true,
  "workspaces": [
    "backend",
    "client",
    "admin"
  ],
  "scripts": {
    "dev:backend": "cd backend && bun run dev",
    "dev:client": "cd client && bun run dev",
    "dev:admin": "cd admin && bun run dev -- --port 5174",
    "build:backend": "cd backend && bun run build",
    "build:client": "cd client && bun run build",
    "build:admin": "cd admin && bun run build",
    "build:all": "bun run build:backend && bun run build:client && bun run build:admin",
    "typecheck:all": "cd backend && bun run typecheck && cd ../client && tsc -b && cd ../admin && tsc -b",
    "db:push": "cd backend && bun run db:push",
    "db:migrate": "cd backend && bun run db:migrate",
    "db:migrate:deploy": "cd backend && bun run db:migrate:deploy",
    "db:seed": "cd backend && bun run db:seed",
    "db:studio": "cd backend && bun run db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
