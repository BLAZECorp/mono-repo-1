# Monorepo / Multi-project root gitignore

# Dependencies
node_modules/
**/node_modules/
bun.lockb
package-lock.json
pnpm-lock.yaml
yarn.lock

# Build Outputs
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/.next/
*.tsbuildinfo

# Environment & Secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.log*
logs/
**/logs/

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# IDE & OS Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
